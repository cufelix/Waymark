# Copy to .env and fill in. Never commit .env.
# docker-compose.yml refuses to start without POSTGRES_PASSWORD; use a long random value on a server.
# The local dev database (pnpm db:local) uses the password "research".
POSTGRES_PASSWORD=research
DATABASE_URL=postgres://research:research@localhost:5433/research
PORT=8787
# Comma-separated bearer keys that may call this API
API_KEYS=dev-key-change-me
SNAPSHOT_DIR=./data/snapshots
# Personal data is hidden at expiry and purged by the background retention worker.
PERSONAL_DATA_RETENTION_DAYS=90
RETENTION_PURGE_INTERVAL_MINUTES=60
DELETION_RETRY_INTERVAL_SECONDS=60

OPENROUTER_API_KEY=
# Fail closed: use only zero-retention endpoints and deny provider data collection.
# Relax only after an explicit processor/provider review.
OPENROUTER_ZDR=1
OPENROUTER_DATA_COLLECTION=deny
LLM_AGENT_MODEL=anthropic/claude-sonnet-5.5
LLM_FAST_MODEL=anthropic/claude-haiku-5.5

APIFY_TOKEN=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=

# Hard monthly caps in USD per paid tool
CAP_LLM_USD=50
CAP_APIFY_USD=50
CAP_EXA_USD=50
CAP_FIRECRAWL_USD=50

# Agent exploration budget per new input (USD)
AGENT_MAX_USD=0.15

# Keys seeker ownership proof tokens; long random value in production
PROOF_SECRET=change-me-to-a-long-random-value

# Human-vetted Apify actors that skip the usage check (still capped per run), e.g. for niche platforms like SoundCloud
APIFY_ALLOWED_ACTORS=

# Serve the UI from this server with a key-less API bridge, for this machine only (0 or 1)
UI_LOCAL=0
