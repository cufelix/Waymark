# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://research:research@localhost:5433/research
PORT=8787
# Comma-separated bearer keys that may call this API
API_KEYS=dev-key-change-me
SNAPSHOT_DIR=./data/snapshots

OPENROUTER_API_KEY=
LLM_AGENT_MODEL=anthropic/claude-sonnet-5.5
LLM_FAST_MODEL=anthropic/claude-haiku-5.5

APIFY_TOKEN=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=

# Hard monthly caps in USD per paid tool
CAP_LLM_USD=50
CAP_APIFY_USD=50
CAP_EXA_USD=50
CAP_FIRECRAWL_USD=50
