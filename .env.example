# Copy to .env and fill in. Never commit .env.
# docker-compose.yml refuses to start without POSTGRES_PASSWORD; use a long random value on a server.
# The local dev database (pnpm db:local) uses the password "research".
POSTGRES_PASSWORD=research
DATABASE_URL=postgres://research:research@localhost:5433/research
PORT=8787
# Comma-separated bearer keys that may call this API
API_KEYS=dev-key-change-me
SNAPSHOT_DIR=./data/snapshots

OPENROUTER_API_KEY=
LLM_AGENT_MODEL=anthropic/claude-sonnet-5.5
LLM_FAST_MODEL=anthropic/claude-haiku-5.5

APIFY_TOKEN=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=

# Hard monthly caps in USD per paid tool
CAP_LLM_USD=50
CAP_APIFY_USD=50
CAP_EXA_USD=50
CAP_FIRECRAWL_USD=50

# Agent exploration budget per new input (USD)
AGENT_MAX_USD=0.15

# Keys seeker ownership proof tokens; long random value in production
PROOF_SECRET=change-me-to-a-long-random-value
