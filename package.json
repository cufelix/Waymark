{
  "name": "waymark",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:node": "node --test --test-reporter=dot $(git ls-files 'src/**/*.test.ts')",
    "typecheck": "tsc --noEmit",
    "check": "pnpm test && pnpm test:node && pnpm typecheck",
    "db:local": "tsx src/db/local.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@mendable/firecrawl-js": "4.45.0",
    "apify-client": "2.25.0",
    "exa-js": "2.25.0",
    "hono": "4.13.13",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "pg-boss": "12.37.0",
    "tsx": "4.23.15",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
