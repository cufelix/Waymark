    "hono": "4.13.13",
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "tsx": "4.23.15",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
